# Required in production. Use a PostgreSQL pool endpoint near Vercel fra1.
DATABASE_URL=
# Optional direct endpoint used only by npm run db:migrate.
MIGRATION_DATABASE_URL=
APP_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=
# Push Notifications config
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Development only. Ignored in production and on Vercel.
DEMO_MODE=true
# If no DATABASE_URL is set, development uses embedded PostgreSQL here.
PGLITE_PATH=.local/postgres
